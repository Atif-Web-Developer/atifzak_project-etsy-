# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave empty to use local SQLite (db.sqlite3).
# For PostgreSQL (Neon/Supabase), paste the connection string, e.g.:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- AI (Google Gemini) ---
GEMINI_API_KEY=

# --- RapidAPI ---
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# --- Google Sheets (eBay dropshipping) ---
# Path to the service account JSON file (keep that file out of GitHub too)
GOOGLE_SERVICE_ACCOUNT_FILE=
EBAY_SHEET_ID=
EBAY_PRODUCT_WORKSHEET=
EBAY_COMPETITOR_WORKSHEET=

# --- Email ---
# Keep EMAIL_BACKEND commented out to print emails in the console (development).
# For real emails, uncomment it:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Your Name <you@example.com>
